@model IEnumerable<LibraryManagementSystem.Models.Borrowing>

@{
    ViewData["Title"] = "Overdue Books";
}

<div class="container mt-4">

    <!-- PAGE HEADER -->

    <div class="mb-4">

        <h1>Overdue Books</h1>

        <p class="text-muted">
            View books that have passed their due date
            and have not yet been returned.
        </p>

    </div>


    <!-- SUMMARY -->

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h5 class="card-title">
                        Overdue Books
                    </h5>

                    <h2 class="display-5">
                        @Model.Count()
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- OVERDUE TABLE -->
    @if (Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-header">

                <h4 class="mb-0">
                    Overdue Borrowings
                </h4>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Book</th>
                                <th>Member</th>
                                <th>Borrow Date</th>
                                <th>Due Date</th>
                                <th>Days Overdue</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var borrowing in Model)
                            {
                                var daysOverdue =
                                    (DateTime.UtcNow.Date -
                                     borrowing.DueDate.Date).Days;

                                <tr>

                                    <!-- BOOK -->

                                    <td>
                                        <strong>
                                            @(borrowing.Book?.Title
                                                ?? "Unknown Book")
                                        </strong>
                                    </td>


                                    <!-- MEMBER -->

                                    <td>

                                        @if (borrowing.User != null)
                                        {
                                            var memberName =
                                                $"{borrowing.User.FirstName} {borrowing.User.LastName}"
                                                .Trim();

                                            if (!string.IsNullOrWhiteSpace(memberName))
                                            {
                                                @memberName
                                            }
                                            else
                                            {
                                                @borrowing.User.Email
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unknown Member
                                            </span>
                                        }

                                    </td>


                                    <!-- BORROW DATE -->

                                    <td>
                                        @(borrowing.BorrowDate
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy"))
                                    </td>


                                    <!-- DUE DATE -->

                                    <td>
                                        <strong>
                                            @(borrowing.DueDate
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy"))
                                        </strong>
                                    </td>


                                    <!-- DAYS OVERDUE -->

                                    <td>

                                        <span class="badge bg-danger">
                                            @daysOverdue day@(daysOverdue == 1 ? "" : "s")
                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span class="badge bg-danger">
                                            Overdue
                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-success">

            <h5 class="alert-heading">
                No overdue books
            </h5>

            <p class="mb-0">
                There are currently no overdue books in the library.
            </p>

        </div>
    }


    <!-- NAVIGATION -->

    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Reports
        </a>

        <a asp-controller="Librarian"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Dashboard
        </a>

    </div>

</div>