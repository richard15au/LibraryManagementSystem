@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Most Popular Books";
}

<div class="container mt-4">

    <!-- PAGE HEADER -->

    <div class="mb-4">

        <h1>Most Popular Books</h1>

        <p class="text-muted">
            View books ranked by the number of borrowing transactions.
        </p>

    </div>


    <!-- SUMMARY -->

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h5 class="card-title">
                        Books with Borrowing Activity
                    </h5>

                    <h2 class="display-5">
                        @Model.Count()
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- POPULAR BOOKS TABLE -->
    @if (Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-header">

                <h4 class="mb-0">
                    Book Popularity
                </h4>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Rank
                                </th>

                                <th>
                                    Book
                                </th>

                                <th>
                                    ISBN
                                </th>

                                <th>
                                    Total Borrowings
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                var rank = 1;
                            }

                            @foreach (var book in Model)
                            {
                                <tr>

                                    <!-- RANK -->

                                    <td>

                                        @if (rank == 1)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                #1
                                            </span>
                                        }
                                        else
                                        {
                                            <strong>
                                                #@rank
                                            </strong>
                                        }

                                    </td>


                                    <!-- BOOK -->

                                    <td>

                                        <strong>
                                            @book.BookTitle
                                        </strong>

                                    </td>


                                    <!-- ISBN -->

                                    <td>
                                        @book.ISBN
                                    </td>


                                    <!-- BORROWINGS -->

                                    <td>

                                        <span class="badge bg-primary">
                                            @book.BorrowingCount
                                        </span>

                                    </td>

                                </tr>

                                rank++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info">

            <h5 class="alert-heading">
                No borrowing data
            </h5>

            <p class="mb-0">
                There are currently no borrowing transactions
                available for this report.
            </p>

        </div>
    }


    <!-- NAVIGATION -->

    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Reports
        </a>

        <a asp-controller="Librarian"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Dashboard
        </a>

    </div>

</div>