@model IEnumerable<LibraryManagementSystem.ViewModels.BorrowingTrendViewModel>

@{
    ViewData["Title"] = "Borrowing Trends";
}

<div class="container mt-4">

    <!-- PAGE HEADER -->

    <div class="mb-4">
        <h1>Borrowing Trends</h1>

        <p class="text-muted">
            View library borrowing activity by month.
        </p>
    </div>


    <!-- SUMMARY -->
    @{
        var totalBorrowings = Model.Sum(x => x.BorrowingCount);
        var monthsWithActivity = Model.Count();
    }

    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">

                    <h5 class="card-title">
                        Total Borrowings
                    </h5>

                    <h2 class="display-5">
                        @totalBorrowings
                    </h2>

                </div>
            </div>
        </div>


        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">

                    <h5 class="card-title">
                        Months with Activity
                    </h5>

                    <h2 class="display-5">
                        @monthsWithActivity
                    </h2>

                </div>
            </div>
        </div>

    </div>


    <!-- BORROWING TREND TABLE -->
    @if (Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-header">
                <h4 class="mb-0">
                    Monthly Borrowing Activity
                </h4>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>

                                <th>
                                    Year
                                </th>

                                <th>
                                    Month
                                </th>

                                <th>
                                    Borrowings
                                </th>

                                <th>
                                    Activity
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var trend in Model)
                            {
                                var maximum = Model.Max(
                                    x => x.BorrowingCount);

                                var percentage = maximum > 0
                                    ? (trend.BorrowingCount * 100 / maximum)
                                    : 0;

                                <tr>

                                    <td>
                                        @trend.Year
                                    </td>

                                    <td>
                                        <strong>
                                            @trend.MonthName
                                        </strong>
                                    </td>

                                    <td>
                                        <strong>
                                            @trend.BorrowingCount
                                        </strong>
                                    </td>

                                    <td>

                                        <div class="progress"
                                             style="height: 24px;">

                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width: @percentage%;">

                                                @trend.BorrowingCount

                                            </div>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info">

            <h5 class="alert-heading">
                No borrowing data
            </h5>

            <p class="mb-0">
                There are currently no borrowing transactions
                available for this report.
            </p>

        </div>
    }


    <!-- NAVIGATION -->

    <div class="mt-4 mb-3">

        <a asp-action="Overdue"
           class="btn btn-danger">
            ⚠️ View Overdue Books
        </a>

        <a asp-action="ActiveMembers"
           class="btn btn-primary">
            👥 Most Active Members
        </a>

        <a asp-action="PopularBooks"
           class="btn btn-success">
            📚 Most Popular Books
        </a>

    </div>

    <div class="mt-3">

        <a asp-controller="Librarian"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>