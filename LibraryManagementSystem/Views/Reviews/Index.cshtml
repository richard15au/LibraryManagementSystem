@model IEnumerable<LibraryManagementSystem.Models.Review>

@{
    var isLibrarian = User.IsInRole("Librarian");

    ViewData["Title"] = isLibrarian
        ? "Review Management"
        : "My Feedback & Ratings";

    var currentUserId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container mt-4 mb-5">

    <!-- Page Header -->
    <div class="mb-4">

        @if (isLibrarian)
        {
            <h1>📝 Review Management</h1>

            <p class="text-muted mb-0">
                View and manage feedback and ratings submitted by members.
            </p>
        }
        else
        {
            <h1>⭐ My Feedback & Ratings</h1>

            <p class="text-muted mb-0">
                View and manage your submitted book ratings and feedback.
            </p>
        }

    </div>


    <!-- Member Navigation -->
    @if (!isLibrarian)
    {
        <div class="mb-4">

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-outline-primary">
                📚 Browse Books
            </a>

        </div>
    }


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Unable to complete request.</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- No Reviews -->
    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center p-5">

                <div class="display-4 mb-3">
                    📝
                </div>

                @if (isLibrarian)
                {
                    <h4>No Member Reviews Found</h4>

                    <p class="text-muted mb-0">
                        There are currently no member reviews in the system.
                    </p>
                }
                else
                {
                    <h4>No Feedback Submitted Yet</h4>

                    <p class="text-muted">
                        You have not submitted any book reviews yet.
                    </p>

                    <a asp-controller="Books"
                       asp-action="Index"
                       class="btn btn-primary">
                        📚 Browse Books
                    </a>
                }

            </div>

        </div>
    }
    else
    {
        <!-- Review Summary -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            @(isLibrarian
                                ? "Total Reviews"
                                : "My Reviews")
                        </h6>

                        <h3 class="mb-0">
                            @Model.Count()
                        </h3>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Approved
                        </h6>

                        <h3 class="mb-0">
                            @Model.Count(r => r.IsApproved)
                        </h3>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Pending
                        </h6>

                        <h3 class="mb-0">
                            @Model.Count(r => !r.IsApproved)
                        </h3>

                    </div>

                </div>

            </div>

        </div>


        <!-- Reviews Table -->
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Book
                                </th>

                                @if (isLibrarian)
                                {
                                    <th>
                                        Member
                                    </th>
                                }

                                <th>
                                    Rating
                                </th>

                                <th>
                                    Feedback
                                </th>

                                <th>
                                    Review Date
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var review in Model)
                            {
                                <tr>

                                    <!-- Book -->
                                    <td>
                                        <strong>
                                            @(review.Book?.Title ?? "Unknown Book")
                                        </strong>
                                    </td>


                                    <!-- Member -->
                                    @if (isLibrarian)
                                    {
                                        <td>

                                            @if (review.User != null)
                                            {
                                                var memberName =
                                                    $"{review.User.FirstName} {review.User.LastName}"
                                                    .Trim();

                                                if (!string.IsNullOrWhiteSpace(memberName))
                                                {
                                                    @memberName
                                                }
                                                else
                                                {
                                                    @review.User.Email
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Unknown Member
                                                </span>
                                            }

                                        </td>
                                    }


                                    <!-- Rating -->
                                    <td>

                                        <div class="text-warning">

                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <span>★</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        ★
                                                    </span>
                                                }
                                            }

                                        </div>

                                        <small class="text-muted">
                                            @review.Rating / 5
                                        </small>

                                    </td>


                                    <!-- Feedback -->
                                    <td>

                                        @if (string.IsNullOrWhiteSpace(review.Comment))
                                        {
                                            <span class="text-muted">
                                                No written feedback
                                            </span>
                                        }
                                        else
                                        {
                                            @review.Comment
                                        }

                                    </td>


                                    <!-- Review Date -->
                                    <td>
                                        @review.ReviewDate.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (review.IsApproved)
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        @if (isLibrarian)
                                        {
                                            @if (!review.IsApproved)
                                            {
                                                <form asp-action="Approve"
                                                      asp-route-id="@review.ReviewId"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">
                                                        Approve
                                                    </button>

                                                </form>
                                            }

                                            <form asp-action="Delete"
                                                  asp-route-id="@review.ReviewId"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this review?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Delete
                                                </button>

                                            </form>
                                        }
                                        else if (review.UserId == currentUserId)
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@review.ReviewId"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this review?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Delete
                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>