@model IEnumerable<LibraryManagementSystem.Models.Review>

@{
    ViewData["Title"] = "Review Management";
}

<div class="container mt-4">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="mb-4">

        <h1>Review Management</h1>

        @if (User.IsInRole("Librarian"))
        {
            <p class="text-muted mb-0">
                View and manage feedback and ratings submitted by members.
            </p>
        }
        else
        {
            <p class="text-muted mb-0">
                View and manage your book reviews.
            </p>
        }

    </div>


    <!-- ========================================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ========================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Unable to complete request.</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- NO REVIEWS -->
    <!-- ========================================================= -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">

            <h5 class="alert-heading">
                No reviews found
            </h5>

            @if (User.IsInRole("Librarian"))
            {
                <p class="mb-0">
                    There are currently no member reviews in the system.
                </p>
            }
            else
            {
                <p class="mb-0">
                    You have not submitted any reviews yet.
                </p>
            }

        </div>
    }
    else
    {
        <!-- ===================================================== -->
        <!-- REVIEWS TABLE -->
        <!-- ===================================================== -->

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Book
                                </th>

                                @if (User.IsInRole("Librarian"))
                                {
                                    <th>
                                        Member
                                    </th>
                                }

                                <th>
                                    Rating
                                </th>

                                <th>
                                    Comment
                                </th>

                                <th>
                                    Review Date
                                </th>

                                <th>
                                    Approval
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var review in Model)
                            {
                                <tr>

                                    <!-- BOOK -->

                                    <td>
                                        <strong>
                                            @(review.Book?.Title
                                                ?? "Unknown Book")
                                        </strong>
                                    </td>


                                    <!-- MEMBER -->
                                    @if (User.IsInRole("Librarian"))
                                    {
                                        <td>

                                            @if (review.User != null)
                                            {
                                                var memberName =
                                                    $"{review.User.FirstName} {review.User.LastName}"
                                                    .Trim();

                                                if (!string.IsNullOrWhiteSpace(memberName))
                                                {
                                                    @memberName
                                                }
                                                else
                                                {
                                                    @review.User.Email
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Unknown Member
                                                </span>
                                            }

                                        </td>
                                    }


                                    <!-- RATING -->

                                    <td>

                                        <div class="text-warning">

                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <span>★</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        ★
                                                    </span>
                                                }
                                            }

                                        </div>

                                        <small class="text-muted">
                                            @review.Rating / 5
                                        </small>

                                    </td>


                                    <!-- COMMENT -->

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(
                                            review.Comment))
                                        {
                                            <span class="text-muted">
                                                No comment provided
                                            </span>
                                        }
                                        else
                                        {
                                            @review.Comment
                                        }

                                    </td>


                                    <!-- REVIEW DATE -->

                                    <td>
                                        @(review.ReviewDate.ToLocalTime().ToString("dd/MM/yyyy"))
                                    </td>


                                    <!-- APPROVAL -->

                                    <td>

                                        @if (review.IsApproved)
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        @if (User.IsInRole("Librarian") ||
                                             review.UserId == User.FindFirst(
                                                 System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@review.ReviewId"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this review?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Delete
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No actions
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>