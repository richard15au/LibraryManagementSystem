@model LibraryManagementSystem.Models.Library?

@{
    ViewData["Title"] = "Library Profile";
}

<div class="container mt-4">

    <!-- PAGE HEADER -->

    <div class="mb-4">

        <h1>
            📚 Library Profile
        </h1>

        <p class="text-muted">
            Manage the library information displayed to members.
        </p>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- NO LIBRARY PROFILE -->
    @if (Model == null)
    {
        <div class="card shadow-sm">

            <div class="card-body text-center p-5">

                <h3>
                    No Library Profile Found
                </h3>

                <p class="text-muted">
                    A library profile has not been configured yet.
                </p>

                <p class="mb-0">
                    Please configure the library profile in the database.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- LIBRARY PROFILE CARD -->

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <!-- LIBRARY NAME -->

                <div class="text-center mb-4">

                    <h2>
                        @Model.Name
                    </h2>

                    <span class="badge bg-success">
                        Active Library Profile
                    </span>

                </div>


                <div class="row g-4">

                    <!-- LOCATION -->

                    <div class="col-md-6">

                        <div class="border rounded p-4 h-100">

                            <h5>
                                📍 Location
                            </h5>

                            <p class="mb-0">
                                @Model.Location
                            </p>

                        </div>

                    </div>


                    <!-- OPERATING HOURS -->

                    <div class="col-md-6">

                        <div class="border rounded p-4 h-100">

                            <h5>
                                🕒 Operating Hours
                            </h5>

                            <p class="mb-0">
                                @Model.OperatingHours
                            </p>

                        </div>

                    </div>


                    <!-- CONTACT DETAILS -->

                    <div class="col-md-6">

                        <div class="border rounded p-4 h-100">

                            <h5>
                                📞 Contact Details
                            </h5>

                            <p class="mb-0">
                                @Model.ContactDetails
                            </p>

                        </div>

                    </div>


                    <!-- PROFILE PURPOSE -->

                    <div class="col-md-6">

                        <div class="border rounded p-4 h-100">

                            <h5>
                                ℹ️ Profile Information
                            </h5>

                            <p class="mb-0">
                                This information is displayed to
                                library members on the homepage.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="text-center mt-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.LibraryId"
                       class="btn btn-primary">

                        ✏️ Edit Library Profile

                    </a>

                    <a asp-action="Details"
                       asp-route-id="@Model.LibraryId"
                       class="btn btn-outline-primary ms-2">

                        👁️ View Details

                    </a>

                </div>

            </div>

        </div>
    }

</div>