@model LibraryManagementSystem.ViewModels.BorrowBookViewModel

@{
    ViewData["Title"] = "Borrow Book";
}

<h1>Borrow Book</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Borrow" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group mb-3">

                <label asp-for="BookId"
                       class="control-label">
                    Book
                </label>

                <select asp-for="BookId"
                        asp-items="Model.Books"
                        class="form-control">

                    <option value="">
                        -- Select Book --
                    </option>

                </select>

                <span asp-validation-for="BookId"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Borrow Book
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Borrowings
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}