@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="mb-4">
        <h1>Book Details</h1>

        <p class="text-muted">
            View book information, availability and reader reviews.
        </p>
    </div>


    <div class="row">

        <!-- ===================================================== -->
        <!-- BOOK COVER -->
        <!-- ===================================================== -->

        <div class="col-md-4 text-center mb-4">

            @if (!string.IsNullOrEmpty(Model.CoverImage))
            {
                <img src="@Model.CoverImage"
                     alt="@Model.Title cover"
                     class="img-fluid rounded shadow"
                     style="max-width:280px;
                max-height:400px;
                object-fit:contain;" />
            }
            else
            {
                <div class="d-flex
                    align-items-center
                    justify-content-center
                    bg-light
                    rounded
                    shadow-sm"
                     style="width:280px;
                    height:400px;
                    margin:auto;">

                    <span class="text-muted">
                        No Cover Available
                    </span>

                </div>
            }

        </div>


        <!-- ===================================================== -->
        <!-- BOOK INFORMATION -->
        <!-- ===================================================== -->

        <div class="col-md-8">

            <h2 class="mb-3">
                @Model.Title
            </h2>

            <hr />

            <dl class="row">

                <!-- ISBN -->

                <dt class="col-sm-3">
                    ISBN
                </dt>

                <dd class="col-sm-9">
                    @Model.ISBN
                </dd>


                <!-- GENRE -->

                <dt class="col-sm-3">
                    Genre
                </dt>

                <dd class="col-sm-9">
                    @(Model.Genre?.Name ?? "Unknown")
                </dd>


                <!-- AUTHORS -->

                <dt class="col-sm-3">
                    Author(s)
                </dt>

                <dd class="col-sm-9">

                    @if (Model.BookAuthors != null &&
                         Model.BookAuthors.Any())
                    {
                        foreach (var bookAuthor in Model.BookAuthors)
                        {
                            <div>
                                <strong>
                                    @bookAuthor.Author?.FirstName
                                    @bookAuthor.Author?.LastName
                                </strong>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">
                            No author assigned
                        </span>
                    }

                </dd>


                <!-- PUBLISHED DATE -->

                <dt class="col-sm-3">
                    Published
                </dt>

                <dd class="col-sm-9">
                    @(Model.PublishedDate?.ToString("dd MMMM yyyy")
                        ?? "Unknown")
                </dd>


                <!-- AVAILABILITY -->

                <dt class="col-sm-3">
                    Availability
                </dt>

                <dd class="col-sm-9">

                    @if (Model.AvailabilityStatus == "Available")
                    {
                        <span class="badge bg-success fs-6">
                            Available
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">
                            @Model.AvailabilityStatus
                        </span>
                    }

                </dd>

            </dl>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="mt-4">

                <h4>Summary</h4>

                @if (string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <p class="text-muted">
                        No summary available.
                    </p>
                }
                else
                {
                    <p>
                        @Model.Summary
                    </p>
                }

            </div>


            <!-- ================================================= -->
            <!-- ACTION BUTTONS -->
            <!-- ================================================= -->

            <div class="mt-4">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- ========================================= -->
                    <!-- MEMBER ACTIONS -->
                    <!-- ========================================= -->
                    @if (User.IsInRole("Member"))
                    {
                        <!-- BORROW -->
                        @if (Model.AvailabilityStatus == "Available")
                        {
                            <form asp-controller="Borrowings"
                                  asp-action="Borrow"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="BookId"
                                       value="@Model.BookId" />

                                <button type="submit"
                                        class="btn btn-success me-2">
                                    Borrow Book
                                </button>

                            </form>
                        }
                        else
                        {
                            <!-- RESERVE -->

                            <a asp-controller="Reservations"
                               asp-action="Create"
                               asp-route-bookId="@Model.BookId"
                               class="btn btn-warning me-2">
                                Reserve Book
                            </a>
                        }


                        <!-- REVIEW -->

                        <a asp-controller="Reviews"
                           asp-action="Create"
                           asp-route-bookId="@Model.BookId"
                           class="btn btn-outline-primary me-2">
                            Write a Review
                        </a>
                    }


                    <!-- ========================================= -->
                    <!-- LIBRARIAN ACTIONS -->
                    <!-- ========================================= -->
                    @if (User.IsInRole("Librarian"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.BookId"
                           class="btn btn-primary me-2">
                            Edit Book
                        </a>
                    }

                }

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to Books
                </a>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- READER REVIEWS -->
    <!-- ========================================================= -->

    <hr class="my-5" />

    <section>

        <h3 class="mb-4">
            Reader Reviews
        </h3>

        @if (Model.Reviews != null &&
             Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews
                .OrderByDescending(r => r.ReviewDate))
            {
                <div class="card mb-3 shadow-sm">

                    <div class="card-body">

                        <div class="d-flex
                            justify-content-between
                            align-items-start">

                            <div>

                                <strong>
                                    @(review.User?.FirstName
                                        ?? "Member")

                                    @(review.User?.LastName
                                        ?? "")
                                </strong>

                                <div class="text-warning">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        @if (i <= review.Rating)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                ★
                                            </span>
                                        }
                                    }

                                </div>

                            </div>

                            <small class="text-muted">
                                @review.ReviewDate
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy")
                            </small>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            review.Comment))
                        {
                            <p class="mt-3 mb-0">
                                @review.Comment
                            </p>
                        }

                    </div>

                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                No reviews have been submitted for this book yet.
            </div>
        }

    </section>

</div>