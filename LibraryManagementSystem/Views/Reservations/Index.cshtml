@model IEnumerable<LibraryManagementSystem.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";
}

<div class="container mt-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Reservations</h1>

            @if (User.IsInRole("Librarian"))
            {
                <p class="text-muted mb-0">
                    Manage all library member reservations.
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    View and manage your book reservations.
                </p>
            }
        </div>

        @if (User.IsInRole("Member"))
        {
            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-primary">
                📚 Browse Books
            </a>
        }

    </div>


    <!-- ========================================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ========================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Unable to complete request.</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- RESERVATIONS -->
    <!-- ========================================================= -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Book</th>
                                <th>Member</th>
                                <th>Reservation Date</th>
                                <th>Expiry Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var reservation in Model)
                            {
                                <tr>

                                    <!-- BOOK -->

                                    <td>
                                        <strong>
                                            @(reservation.Book?.Title
                                                ?? "Unknown Book")
                                        </strong>
                                    </td>


                                    <!-- MEMBER -->

                                    <td>

                                        @if (reservation.User != null)
                                        {
                                            var fullName =
                                                $"{reservation.User.FirstName} {reservation.User.LastName}"
                                                .Trim();

                                            @if (!string.IsNullOrWhiteSpace(fullName))
                                            {
                                                @fullName
                                            }
                                            else
                                            {
                                                @reservation.User.Email
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unknown Member
                                            </span>
                                        }

                                    </td>


                                    <!-- RESERVATION DATE -->

                                    <td>
                                        @(reservation.ReservationDate
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy"))
                                    </td>


                                    <!-- EXPIRY DATE -->

                                    <td>

                                        @if (reservation.ExpiryDate.HasValue)
                                        {
                                            @(reservation.ExpiryDate.Value
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy"))
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No expiry date
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (reservation.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (reservation.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @reservation.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        @if (reservation.Status == "Active")
                                        {
                                            <form asp-action="Cancel"
                                                  asp-route-id="@reservation.ReservationId"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to cancel this reservation?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Cancel
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No actions
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- ===================================================== -->
        <!-- EMPTY STATE -->
        <!-- ===================================================== -->

        <div class="alert alert-info">

            <h5 class="alert-heading">
                No reservations found
            </h5>

            @if (User.IsInRole("Librarian"))
            {
                <p class="mb-0">
                    There are currently no book reservations
                    in the system.
                </p>
            }
            else
            {
                <p class="mb-0">
                    You currently have no book reservations.
                </p>
            }

        </div>
    }

</div>