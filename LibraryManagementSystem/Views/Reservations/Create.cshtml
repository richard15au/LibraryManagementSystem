@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Reserve Book";
}

<h1>Reserve Book</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <h4>@Model.Title</h4>

        <p>
            <strong>ISBN:</strong>
            @Model.ISBN
        </p>

        <p>
            <strong>Availability:</strong>
            @Model.AvailabilityStatus
        </p>

        <div class="alert alert-info">
            Are you sure you want to reserve this book?
        </div>

        <form asp-action="Create" method="post">

            <input type="hidden"
                   name="bookId"
                   value="@Model.BookId" />

            <button type="submit"
                    class="btn btn-primary">
                Confirm Reservation
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>