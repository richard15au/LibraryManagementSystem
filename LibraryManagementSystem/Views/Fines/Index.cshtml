@model IEnumerable<LibraryManagementSystem.Models.Fine>

@{
    ViewData["Title"] = "Fine Management";
}

<div class="container mt-4 mb-5">

    <!-- Header -->
    <div class="mb-4">

        @if (User.IsInRole("Librarian"))
        {
            <h1>💰 Fine Management</h1>

            <p class="text-muted">
                View and manage fines for library members.
            </p>
        }
        else
        {
            <h1>💰 My Fines</h1>

            <p class="text-muted">
                View your fines and payment status.
            </p>
        }

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Error:</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Summary -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Fines
                    </h6>

                    <h3 class="mb-0">
                        @Model.Count()
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Outstanding
                    </h6>

                    <h3 class="mb-0">
                        @Model.Count(f => f.Status != "Paid")
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Paid
                    </h6>

                    <h3 class="mb-0">
                        @Model.Count(f => f.Status == "Paid")
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- No Fines -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">

            <h5 class="alert-heading">
                No fines found
            </h5>

            <p class="mb-0">
                There are currently no fines to display.
            </p>

        </div>
    }
    else
    {
        <!-- Fine Table -->

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                @if (User.IsInRole("Librarian"))
                                {
                                    <th>Member</th>
                                }

                                <th>Book</th>
                                <th>Amount</th>
                                <th>Reason</th>
                                <th>Issued Date</th>
                                <th>Paid Date</th>
                                <th>Status</th>
                                <th>Actions</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var fine in Model)
                            {
                                <tr>

                                    <!-- Member -->
                                    @if (User.IsInRole("Librarian"))
                                    {
                                        <td>
                                            <strong>
                                                @fine.Borrowing?.User?.FirstName
                                                @fine.Borrowing?.User?.LastName
                                            </strong>
                                        </td>
                                    }


                                    <!-- Book -->
                                    <td>
                                        <strong>
                                            @fine.Borrowing?.Book?.Title
                                        </strong>
                                    </td>


                                    <!-- Amount -->
                                    <td>
                                        <strong>
                                            @fine.Amount.ToString("C")
                                        </strong>
                                    </td>


                                    <!-- Reason -->
                                    <td>
                                        @fine.Reason
                                    </td>


                                    <!-- Issued Date -->
                                    <td>
                                        @(fine.IssuedDate
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy"))
                                    </td>


                                    <!-- Paid Date -->
                                    <td>
                                        @if (fine.PaidDate.HasValue)
                                        {
                                            @(fine.PaidDate.Value
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy"))
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not paid
                                            </span>
                                        }
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (fine.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Unpaid
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        @if (User.IsInRole("Librarian"))
                                        {
                                            @if (fine.Status != "Paid")
                                            {
                                                <form asp-action="MarkAsPaid"
                                                      asp-route-id="@fine.FineId"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Mark this fine as paid?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">
                                                        Mark as Paid
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Completed
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            @if (fine.Status == "Paid")
                                            {
                                                <span class="text-success">
                                                    Paid
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">
                                                    Payment due
                                                </span>
                                            }
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>