@model IEnumerable<LibraryManagementSystem.Models.Fine>

@{
    ViewData["Title"] = "Fine Management";
}

<div class="container mt-4">

    <!-- PAGE HEADER -->

    <div class="mb-4">
        <h1>Fine Management</h1>

        @if (User.IsInRole("Librarian"))
        {
            <p class="text-muted">
                View and manage fines for library members.
            </p>
        }
        else
        {
            <p class="text-muted">
                View your borrowing fines and payment status.
            </p>
        }
    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Unable to complete request.</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- NO FINES -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">

            <h5 class="alert-heading">
                No fines found
            </h5>

            @if (User.IsInRole("Librarian"))
            {
                <p class="mb-0">
                    There are currently no fines in the system.
                </p>
            }
            else
            {
                <p class="mb-0">
                    You currently have no fines.
                </p>
            }

        </div>
    }
    else
    {
        <!-- FINE TABLE -->

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                @if (User.IsInRole("Librarian"))
                                {
                                    <th>Member</th>
                                }

                                <th>Book</th>
                                <th>Amount</th>
                                <th>Reason</th>
                                <th>Issued Date</th>
                                <th>Paid Date</th>
                                <th>Status</th>

                                @if (User.IsInRole("Librarian"))
                                {
                                    <th>Actions</th>
                                }

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var fine in Model)
                            {
                                <tr>

                                    <!-- MEMBER -->
                                    @if (User.IsInRole("Librarian"))
                                    {
                                        <td>

                                            @if (fine.Borrowing?.User != null)
                                            {
                                                var memberName =
                                                    $"{fine.Borrowing.User.FirstName} {fine.Borrowing.User.LastName}"
                                                    .Trim();

                                                if (!string.IsNullOrWhiteSpace(memberName))
                                                {
                                                    @memberName
                                                }
                                                else
                                                {
                                                    @fine.Borrowing.User.Email
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Unknown Member
                                                </span>
                                            }

                                        </td>
                                    }


                                    <!-- BOOK -->

                                    <td>
                                        <strong>
                                            @(fine.Borrowing?.Book?.Title
                                                ?? "Unknown Book")
                                        </strong>
                                    </td>


                                    <!-- AMOUNT -->

                                    <td>
                                        <strong>
                                            @fine.Amount.ToString("C")
                                        </strong>
                                    </td>


                                    <!-- REASON -->

                                    <td>
                                        @(string.IsNullOrWhiteSpace(fine.Reason)
                                            ? "No reason specified"
                                            : fine.Reason)
                                    </td>


                                    <!-- ISSUED DATE -->

                                    <td>
                                        @(fine.IssuedDate.ToLocalTime().ToString("dd/MM/yyyy"))
                                    </td>


                                    <!-- PAID DATE -->

                                    <td>

                                        @if (fine.PaidDate.HasValue)
                                        {
                                            @(fine.PaidDate.Value.ToLocalTime().ToString("dd/MM/yyyy"))
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not paid
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (fine.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Unpaid
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->
                                    @if (User.IsInRole("Librarian"))
                                    {
                                        <td>

                                            @if (fine.Status != "Paid")
                                            {
                                                <form asp-action="MarkAsPaid"
                                                      asp-route-id="@fine.FineId"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to mark this fine as paid?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">
                                                        Mark as Paid
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Completed
                                                </span>
                                            }

                                        </td>
                                    }

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>