<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Library Management System</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryManagementSystem.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg library-navbar">
            <div class="container">

                <a class="navbar-brand library-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span>
                        <strong>Library</strong>
                        <small>Management System</small>
                    </span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Books"
                                   asp-action="Index">
                                    Books
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Borrowings"
                                   asp-action="Index">
                                    Borrowings
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Reservations"
                                   asp-action="Index">
                                    Reservations
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Fines"
                                   asp-action="Index">
                                    Fines
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Reviews"
                                   asp-action="Index">
                                    Reviews
                                </a>
                            </li>

                            @if (User.IsInRole("Librarian"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-area=""
                                       asp-controller="Reports"
                                       asp-action="Index">
                                        Reports
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <div class="library-account">
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>


    <main role="main">

        <div class="container library-content">

            @RenderBody()

        </div>

    </main>


    <footer class="library-footer">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <div class="footer-brand">
                        <strong>Library Management System</strong>
                    </div>

                    <p class="footer-text">
                        A modern library management solution for students and librarians.
                    </p>

                </div>

                <div class="col-md-6 text-md-end">

                    <p class="footer-text mb-1">
                        ICT272 Web Design and Development
                    </p>

                    <p class="footer-text mb-0">
                        Group 5 · 2026
                    </p>

                </div>

            </div>

            <hr />

            <div class="text-center">

                <small>
                    &copy; 2026 Library Management System ·
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">
                        Privacy
                    </a>
                </small>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>